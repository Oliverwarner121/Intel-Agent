# Application environment guard: local, dev or prod.
# Both Vercel projects deploy to their Production target, so VERCEL_ENV cannot
# tell dev from prod. Only prod will be allowed to deliver email (Phase 3).
APP_ENV=local

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Google Calendar (read-only). Leave blank to report the calendar section as
# not configured. Create a "Desktop app" OAuth client in Google Cloud, set the
# ID and secret here, then run `npm run google:auth` to get the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional: defaults to your primary calendar.
GOOGLE_CALENDAR_ID=

# Resend: sending requires BOTH APP_ENV=prod and EMAIL_SEND_ENABLED=true.
# Leave disabled until an explicitly approved production test.
EMAIL_SEND_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM="Intel-Agent <agent@intel-mail.oliverwarner.co.uk>"
EMAIL_TO=oliver.warner121@gmail.com
